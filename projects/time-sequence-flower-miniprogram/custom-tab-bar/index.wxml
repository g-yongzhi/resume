<view class="tab-bar">
  <view wx:for="{{list}}" wx:key="text" class="tab-item {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="switchTab">
    <image class="tab-icon" src="/assets/icons/{{item.icon}}{{selected === index ? '-active' : ''}}.svg" mode="aspectFit" />
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
