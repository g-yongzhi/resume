page {
  background: #fcfcf9;
  color: #2D3A3A;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.container {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

.page-pad { padding: 24rpx; }

.font-serif {
  font-family: 'Noto Serif SC', 'Songti SC', 'STSong', serif;
  letter-spacing: 0.08em;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(45, 90, 67, 0.12);
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  border-radius: 20rpx;
  background: #eef5f0;
  color: #2D5A43;
  margin-right: 8rpx;
}

.btn-primary {
  background: #2D5A43;
  color: #fff;
  font-weight: 600;
  border-radius: 48rpx;
  text-align: center;
}

.section-head {
  padding: 32rpx 28rpx 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2D3A3A;
  display: block;
}

.section-sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

.section-line {
  width: 48rpx;
  height: 6rpx;
  background: #2D5A43;
  border-radius: 3rpx;
  margin-top: 12rpx;
}
