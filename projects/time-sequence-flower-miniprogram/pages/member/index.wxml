<view class="container member-page">
  <view class="member-header">
    <view class="header-mask"></view>
    <view class="header-content">
      <image class="avatar" src="{{avatar}}" mode="aspectFill" />
      <text class="member-name font-serif">{{userName}}</text>
      <view class="level-badge" style="background:{{level.color}}">
        <text class="level-text">{{level.name}}</text>
      </view>
    </view>
  </view>

  <view class="points-card card">
    <view class="points-row">
      <view class="points-left">
        <text class="points-num">{{points}}</text>
        <text class="points-label">当前积分</text>
      </view>
      <view class="points-divider"></view>
      <view class="points-right">
        <text class="next-label">距下一级</text>
        <text class="next-name" style="color:{{nextLevel.color}}">{{nextLevel.name}}</text>
        <text class="next-need">还需 {{nextLevel.min - points}} 积分</text>
      </view>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width:{{progress}}%; background:{{level.color}}"></view>
    </view>
  </view>

  <view class="section-title font-serif">会员权益</view>
  <view class="perks-grid">
    <view class="perk-card card" wx:for="{{perks}}" wx:key="title">
      <view class="perk-icon-wrap">
        <ui-icon name="{{item.icon}}" size="36" />
      </view>
      <view class="perk-text">
        <text class="perk-title">{{item.title}}</text>
        <text class="perk-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="upgrade-btn" bindtap="onUpgrade">升级会员</view>
</view>
