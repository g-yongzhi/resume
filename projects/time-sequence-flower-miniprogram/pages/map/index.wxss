.map-page { height: 100vh; display: flex; flex-direction: column; padding-bottom: 0; }
.map { width: 100%; flex: 1; min-height: 500rpx; }
.panel {
  margin: -40rpx 24rpx 24rpx;
  padding: 24rpx;
  position: relative;
  z-index: 2;
}
.panel-title { font-size: 32rpx; font-weight: 700; display: block; margin-bottom: 16rpx; }
.spot-list { display: flex; flex-direction: column; }
.spot-item {
  display: flex; align-items: center; padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.spot-item:last-child { border-bottom: none; }
.spot-name { flex: 1; margin-left: 12rpx; font-size: 28rpx; color: #2D3A3A; }
