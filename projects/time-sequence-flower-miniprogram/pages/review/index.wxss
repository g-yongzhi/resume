.review-card { padding: 24rpx; margin-bottom: 20rpx; }
.review-img { width: 100%; height: 240rpx; border-radius: 12rpx; margin-bottom: 16rpx; }
.review-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.review-spot { font-size: 30rpx; font-weight: 700; }
.review-score { font-size: 26rpx; color: #ff9500; font-weight: 600; }
.review-content { display: block; font-size: 26rpx; color: #666; line-height: 1.6; }
.review-date { display: block; font-size: 22rpx; color: #bbb; margin-top: 12rpx; }
