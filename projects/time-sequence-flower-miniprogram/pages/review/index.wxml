<view class="container page-pad">
  <view class="review-card card" wx:for="{{reviews}}" wx:key="id">
    <image wx:if="{{item.image}}" class="review-img" src="{{item.image}}" mode="aspectFill" />
    <view class="review-head">
      <text class="review-spot font-serif">{{item.spot}}</text>
      <text class="review-score">★ {{item.score}}</text>
    </view>
    <text class="review-content">{{item.content}}</text>
    <text class="review-date">{{item.date}}</text>
  </view>
</view>
