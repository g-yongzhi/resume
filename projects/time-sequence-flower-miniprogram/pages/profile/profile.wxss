.profile-head {
  background: linear-gradient(160deg, #2D5A43 0%, #3d7a5a 100%);
  padding: 48rpx 28rpx 56rpx;
  display: flex;
  align-items: center;
  color: #fff;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}

.profile-info {
  flex: 1;
  margin-left: 20rpx;
}

.nickname {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.level {
  font-size: 22rpx;
  opacity: 0.75;
  margin-top: 8rpx;
}

.edit-btn {
  background: rgba(255, 255, 255, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.stats {
  margin: -32rpx 24rpx 24rpx;
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  position: relative;
  z-index: 1;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2D5A43;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #eee;
}

.menu {
  margin: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(45, 90, 67, 0.06);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  background: #eef5f0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.menu-name {
  flex: 1;
  font-size: 28rpx;
}

/* Avatar bottom sheet */
.avatar-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1000;
}
.avatar-sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1001;
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet-bar {
  width: 64rpx; height: 6rpx;
  background: #e0e0e0; border-radius: 3rpx;
  margin: 20rpx auto 32rpx;
}
.sheet-avatar-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}
.sheet-avatar {
  width: 160rpx; height: 160rpx;
  border-radius: 50%;
  border: 3rpx solid #eee;
}
.sheet-tip {
  font-size: 22rpx; color: #bbb;
  margin-top: 12rpx;
}
.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.sheet-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
  background: #f9f9f7;
  border-radius: 20rpx;
}
.sheet-btn-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}
.sheet-btn-label {
  font-size: 26rpx;
  color: #2D3A3A;
  font-weight: 500;
}
.sheet-cancel {
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #999;
  background: #f5f5f5;
  border-radius: 48rpx;
}
