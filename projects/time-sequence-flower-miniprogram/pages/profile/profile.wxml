<view class="container">
  <view class="profile-head">
    <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill" bindtap="onAvatarTap" />
    <view class="profile-info">
      <text class="nickname font-serif">{{userInfo.nickName}}</text>
      <text class="level">{{userInfo.level}}</text>
    </view>
    <view class="edit-btn" bindtap="onProfileAction">{{isLogin ? '个人中心' : '登录 / 注册'}}</view>
  </view>

  <view class="stats card">
    <view class="stat-item"><text class="stat-num">12</text><text class="stat-label">足迹</text></view>
    <view class="stat-divider"></view>
    <view class="stat-item"><text class="stat-num">8</text><text class="stat-label">攻略</text></view>
    <view class="stat-divider"></view>
    <view class="stat-item"><text class="stat-num">36</text><text class="stat-label">收藏</text></view>
  </view>

  <view class="menu card">
    <view class="menu-item" wx:for="{{menus}}" wx:key="name" data-path="{{item.path}}" data-tab="{{item.tab}}" bindtap="goPage">
      <view class="menu-icon-wrap"><ui-icon name="{{item.icon}}" size="36" /></view>
      <text class="menu-name">{{item.name}}</text>
      <ui-icon name="chevron-right" size="28" />
    </view>
  </view>
</view>

<!-- 头像编辑卡片 -->
<view class="avatar-mask" wx:if="{{showSheet}}" bindtap="closeSheet"></view>
<view class="avatar-sheet" wx:if="{{showSheet}}">
  <view class="sheet-bar"></view>
  <view class="sheet-avatar-box">
    <image class="sheet-avatar" src="{{userInfo.avatar}}" mode="aspectFill" bindtap="previewAvatar" />
    <text class="sheet-tip">点击头像可查看大图</text>
  </view>
  <view class="sheet-actions">
    <view class="sheet-btn" bindtap="chooseFromAlbum">
      <text class="sheet-btn-icon">🖼</text>
      <text class="sheet-btn-label">从相册选择</text>
    </view>
    <view class="sheet-btn" bindtap="takePhoto">
      <text class="sheet-btn-icon">📷</text>
      <text class="sheet-btn-label">拍照</text>
    </view>
  </view>
  <view class="sheet-cancel" bindtap="closeSheet">取消</view>
</view>
