<view class="container forum-container page-pad">
  <view class="publish-bar card" bindtap="onPublish">
    <ui-icon name="book-open" size="32" />
    <text>分享你的花期旅行...</text>
  </view>
  <view class="post-card card" wx:for="{{posts}}" wx:key="id">
    <view class="post-head">
      <text class="post-author">{{item.author}}</text>
      <view class="post-like">
        <ui-icon name="heart" size="24" />
        <text>{{item.likes}}</text>
      </view>
    </view>
    <text class="post-title font-serif">{{item.title}}</text>
    <text class="post-content">{{item.content}}</text>
    <image wx:if="{{item.image}}" class="post-img" src="{{item.image}}" mode="widthFix" />
    <text class="post-comments">{{item.comments}} 条评论</text>
  </view>
</view>
