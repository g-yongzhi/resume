/* Page head */
.page-head { margin-bottom: 0; }
.head-kicker { font-size: 22rpx; color: #e88d67; display: block; }
.head-title { font-size: 40rpx; font-weight: 700; display: block; margin: 8rpx 0; }
.head-sub { font-size: 24rpx; color: #999; }

/* Filter bar */
.filter-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 50;
  gap: 12rpx;
}
.filter-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 10rpx 18rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}
.filter-item.active {
  background: #eef5f0;
  color: #2D5A43;
  font-weight: 500;
}
.arrow { font-size: 18rpx; margin-left: 2rpx; }
.filter-clear {
  margin-left: auto;
  font-size: 24rpx;
  color: #e88d67;
  flex-shrink: 0;
}

/* Mask */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.3);
  z-index: 60;
}

/* Dropdown */
.dropdown {
  position: fixed;
  top: 220rpx;
  left: 24rpx;
  right: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
  z-index: 70;
  padding: 16rpx 0;
  max-height: 400rpx;
  overflow-y: auto;
}
.drop-item {
  padding: 22rpx 32rpx;
  font-size: 28rpx;
  color: #2D3A3A;
}
.drop-item.selected {
  color: #2D5A43;
  font-weight: 600;
  background: #eef5f0;
}

/* Facility multi-select */
.facility-drop {
  padding: 0;
  max-height: 520rpx;
}
.drop-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.drop-title {
  font-size: 26rpx;
  color: #999;
}
.drop-all {
  font-size: 24rpx;
  color: #2D5A43;
  font-weight: 500;
}
.check-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
}
.check-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  border: 2rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.check-box text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 700;
}
.check-item.checked .check-box {
  background: #2D5A43;
  border-color: #2D5A43;
}
.drop-foot {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}
.drop-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.drop-btn.cancel {
  background: #f5f5f5;
  color: #999;
}
.drop-btn.confirm {
  background: #2D5A43;
  color: #fff;
}

/* No result */
.no-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}
.nr-icon { font-size: 72rpx; }
.nr-text { font-size: 28rpx; color: #999; margin-top: 16rpx; }
.nr-tip { font-size: 24rpx; color: #ccc; margin-top: 8rpx; }

/* List */
.list { display: flex; flex-direction: column; gap: 20rpx; padding-top: 16rpx; }
.item { display: flex; padding: 20rpx; }
.item-img { width: 200rpx; height: 200rpx; border-radius: 16rpx; flex-shrink: 0; }
.item-body { flex: 1; min-width: 0; margin-left: 20rpx; }
.item-name { font-size: 28rpx; font-weight: 700; display: block; }

/* Stars */
.stars-row { margin-top: 6rpx; }
.star { font-size: 22rpx; color: #e88d67; }
.star.empty { color: #e0e0e0; }

.item-meta { font-size: 22rpx; color: #e88d67; margin-top: 4rpx; }
.reviews { color: #999; margin-left: 12rpx; }
.location { font-size: 22rpx; color: #999; display: block; margin-top: 2rpx; }

/* Tags */
.tags { margin: 8rpx 0 4rpx; }
.tag {
  display: inline-block;
  font-size: 20rpx;
  color: #2D5A43;
  background: #eef5f0;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-right: 6rpx;
}

/* Room types */
.room-types { margin: 4rpx 0; }
.room-chip {
  display: inline-block;
  font-size: 20rpx;
  color: #666;
  background: #f9f9f7;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-right: 6rpx;
  border: 1rpx solid #eee;
}

/* Facilities */
.facilities { margin: 6rpx 0 4rpx; }
.fac-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #999;
  margin-right: 10rpx;
}

/* Price */
.price-row { display: flex; align-items: baseline; margin-top: 4rpx; }
.price { font-size: 32rpx; font-weight: 700; color: #e88d67; }
.old-price { font-size: 20rpx; color: #bbb; text-decoration: line-through; margin-left: 8rpx; }
.unit { font-size: 20rpx; color: #999; margin-left: 4rpx; }
