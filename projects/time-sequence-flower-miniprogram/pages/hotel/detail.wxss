.detail-page { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.cover { width: 100%; height: 420rpx; }
.content { margin-top: -40rpx; position: relative; z-index: 1; }
.title { font-size: 40rpx; font-weight: 700; display: block; }

/* Stars */
.stars-row { margin: 10rpx 0; display: flex; align-items: center; gap: 4rpx; }
.star { font-size: 28rpx; color: #e88d67; }
.star.empty { color: #e0e0e0; }
.star-label { font-size: 24rpx; color: #999; margin-left: 10rpx; }

.meta { font-size: 24rpx; margin: 6rpx 0; }
.reviews { color: #999; }
.location { font-size: 26rpx; color: #666; display: block; }
.tags { margin: 16rpx 0 24rpx; }
.section { padding: 24rpx; margin-bottom: 24rpx; }
.section-label { font-size: 28rpx; font-weight: 600; display: block; margin-bottom: 16rpx; }
.facilities { display: flex; flex-wrap: wrap; gap: 12rpx; }
.facility { background: #eef5f0; color: #2D5A43; font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 20rpx; }

/* Room types */
.room-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.room-chip { font-size: 24rpx; color: #2D5A43; background: #eef5f0; padding: 8rpx 20rpx; border-radius: 20rpx; }
.price-box { display: flex; align-items: baseline; }
.price { font-size: 44rpx; font-weight: 700; color: #e88d67; }
.old-price { font-size: 24rpx; color: #bbb; text-decoration: line-through; margin-left: 12rpx; }
.unit { font-size: 24rpx; color: #999; margin-left: 4rpx; }
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #eee; box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
}
.bottom-price { display: flex; align-items: baseline; }
.bp { font-size: 40rpx; font-weight: 700; color: #e88d67; }
.bu { font-size: 22rpx; color: #999; }
.btn-book {
  background: #2D5A43; color: #fff; font-size: 30rpx; font-weight: 600;
  padding: 24rpx 64rpx; border-radius: 48rpx;
}
