.detail-page { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.cover { width: 100%; height: 400rpx; }
.content { margin-top: -32rpx; }
.title { font-size: 40rpx; font-weight: 700; display: block; }
.badges { margin: 12rpx 0; display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }
.badge { font-size: 20rpx; color: #e88d67; background: #fef3ee; padding: 4rpx 14rpx; border-radius: 8rpx; }
.category { font-size: 22rpx; color: #2D5A43; background: #eef5f0; padding: 4rpx 14rpx; border-radius: 8rpx; }
.meta { font-size: 24rpx; color: #e88d67; margin: 8rpx 0; }
.reviews { color: #999; margin-left: 12rpx; }
.zone { font-size: 26rpx; color: #666; display: block; margin-bottom: 24rpx; }
.section { padding: 24rpx; margin-bottom: 24rpx; }
.section-label { font-size: 28rpx; font-weight: 600; display: block; margin-bottom: 16rpx; }
.dishes { display: flex; flex-direction: column; gap: 10rpx; }
.dish { font-size: 26rpx; color: #555; }
.price-box { display: flex; align-items: baseline; gap: 12rpx; }
.label { font-size: 26rpx; color: #999; }
.price { font-size: 44rpx; font-weight: 700; color: #e88d67; }
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #eee;
}
.bottom-price { display: flex; align-items: baseline; }
.bp { font-size: 40rpx; font-weight: 700; color: #e88d67; }
.bu { font-size: 22rpx; color: #999; }
.btn-book {
  background: #2D5A43; color: #fff; font-size: 30rpx; font-weight: 600;
  padding: 24rpx 64rpx; border-radius: 48rpx;
}
