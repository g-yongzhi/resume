.login-page { padding: 60rpx 32rpx 40rpx; }

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}
.logo-icon { font-size: 80rpx; }
.logo-title { font-size: 40rpx; font-weight: 700; color: #2D3A3A; margin-top: 16rpx; }
.logo-sub { font-size: 24rpx; color: #999; margin-top: 8rpx; }

.form { padding: 8rpx 28rpx 28rpx; }

.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.field-icon { width: 56rpx; flex-shrink: 0; color: #999; }
.field-input {
  flex: 1;
  font-size: 28rpx;
  color: #2D3A3A;
  padding: 4rpx 0;
}
.ph { color: #ccc; }
.field-eye { padding: 8rpx 0 8rpx 16rpx; flex-shrink: 0; }
.field-eye text { font-size: 24rpx; color: #999; }

.btn-login {
  margin-top: 48rpx;
  padding: 24rpx 0;
  text-align: center;
  background: #2D5A43;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
}
.btn-login.disabled { opacity: 0.45; pointer-events: none; }

.switch-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  margin-top: 40rpx;
}
.switch-text { font-size: 26rpx; color: #999; }
.switch-link { font-size: 26rpx; color: #2D5A43; font-weight: 500; }
