<view class="container page-pad login-page">
  <!-- Logo -->
  <view class="login-header">
    <text class="logo-icon">🌸</text>
    <text class="logo-title font-serif">时叙花城</text>
    <text class="logo-sub">记录每一程花期旅行</text>
  </view>

  <!-- Form -->
  <view class="form card">
    <!-- 用户名 -->
    <view class="field">
      <view class="field-icon">
        <ui-icon name="user" size="36" />
      </view>
      <input
        class="field-input"
        placeholder="用户名"
        placeholder-class="ph"
        value="{{username}}"
        bindinput="onUsernameInput"
        maxlength="20"
      />
    </view>

    <!-- 密码 -->
    <view class="field">
      <view class="field-icon">
        <ui-icon name="lock" size="36" />
      </view>
      <input
        class="field-input"
        placeholder="密码（至少4位）"
        placeholder-class="ph"
        type="{{showPwd ? 'text' : 'password'}}"
        password="{{!showPwd}}"
        value="{{password}}"
        bindinput="onPasswordInput"
        maxlength="20"
      />
      <view class="field-eye" bindtap="togglePwd">
        <text>{{showPwd ? '隐藏' : '显示'}}</text>
      </view>
    </view>

    <!-- 登录按钮 -->
    <view class="btn-login {{canSubmit ? '' : 'disabled'}}" bindtap="onLogin">登 录</view>
  </view>

  <!-- 注册入口 -->
  <view class="switch-row">
    <text class="switch-text">还没有账号？</text>
    <text class="switch-link" bindtap="goRegister">立即注册</text>
  </view>
</view>
