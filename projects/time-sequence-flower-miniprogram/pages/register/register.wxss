.reg-page { padding: 48rpx 32rpx 40rpx; }

.reg-header { margin-bottom: 36rpx; }
.reg-title { font-size: 40rpx; font-weight: 700; color: #2D3A3A; display: block; }
.reg-sub { font-size: 24rpx; color: #999; margin-top: 8rpx; display: block; }

.form { padding: 8rpx 28rpx 28rpx; }

.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.field-icon { width: 56rpx; flex-shrink: 0; color: #999; }
.field-input { flex: 1; font-size: 28rpx; color: #2D3A3A; padding: 4rpx 0; }
.ph { color: #ccc; }

.btn-reg {
  margin-top: 48rpx;
  padding: 24rpx 0;
  text-align: center;
  background: #2D5A43;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
}
.btn-reg.disabled { opacity: 0.45; pointer-events: none; }

.switch-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  margin-top: 40rpx;
}
.switch-text { font-size: 26rpx; color: #999; }
.switch-link { font-size: 26rpx; color: #2D5A43; font-weight: 500; }
