<view class="container page-pad reg-page">
  <view class="reg-header">
    <text class="reg-title font-serif">创建账号</text>
    <text class="reg-sub">加入时叙花城，开启花期旅行</text>
  </view>

  <view class="form card">
    <!-- 用户名 -->
    <view class="field">
      <view class="field-icon">
        <ui-icon name="user" size="36" />
      </view>
      <input
        class="field-input"
        placeholder="用户名（必填）"
        placeholder-class="ph"
        value="{{username}}"
        bindinput="onUsernameInput"
        maxlength="20"
      />
    </view>

    <!-- 昵称 -->
    <view class="field">
      <view class="field-icon">
        <ui-icon name="sparkles" size="36" />
      </view>
      <input
        class="field-input"
        placeholder="昵称（选填，默认同用户名）"
        placeholder-class="ph"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        maxlength="12"
      />
    </view>

    <!-- 密码 -->
    <view class="field">
      <view class="field-icon">
        <ui-icon name="lock" size="36" />
      </view>
      <input
        class="field-input"
        placeholder="密码（至少4位）"
        placeholder-class="ph"
        type="password"
        password
        value="{{password}}"
        bindinput="onPasswordInput"
        maxlength="20"
      />
    </view>

    <!-- 确认密码 -->
    <view class="field">
      <view class="field-icon">
        <ui-icon name="lock" size="36" />
      </view>
      <input
        class="field-input"
        placeholder="确认密码"
        placeholder-class="ph"
        type="password"
        password
        value="{{confirmPwd}}"
        bindinput="onConfirmInput"
        maxlength="20"
      />
    </view>

    <view class="btn-reg {{canSubmit ? '' : 'disabled'}}" bindtap="onRegister">注 册</view>
  </view>

  <view class="switch-row">
    <text class="switch-text">已有账号？</text>
    <text class="switch-link" bindtap="goLogin">返回登录</text>
  </view>
</view>
