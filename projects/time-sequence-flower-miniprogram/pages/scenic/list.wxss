.page-head { margin-bottom: 24rpx; }
.head-kicker { font-size: 22rpx; color: #e88d67; display: block; }
.head-title { font-size: 40rpx; font-weight: 700; display: block; margin: 8rpx 0; }
.head-sub { font-size: 24rpx; color: #999; }

.list { display: flex; flex-direction: column; gap: 24rpx; }
.item { position: relative; overflow: hidden; }
.item-img { width: 100%; height: 320rpx; display: block; }
.status {
  position: absolute; top: 20rpx; right: 20rpx;
  background: #2D5A43; color: #fff; font-size: 22rpx;
  padding: 6rpx 16rpx; border-radius: 20rpx;
}
.item-body { padding: 24rpx; }
.top-row { display: flex; justify-content: space-between; align-items: center; }
.item-name { font-size: 34rpx; font-weight: 700; }
.season { font-size: 22rpx; color: #e88d67; background: #fef3ee; padding: 4rpx 14rpx; border-radius: 8rpx; }
.place { font-size: 26rpx; color: #666; display: block; margin: 10rpx 0 4rpx; }
.city { font-size: 24rpx; color: #999; display: block; }
.desc { font-size: 26rpx; color: #2D5A43; display: block; margin: 12rpx 0; font-style: italic; }
.views { font-size: 22rpx; color: #bbb; }
