.detail-page { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); position: relative; }
.cover { width: 100%; height: 480rpx; }
.status {
  position: absolute; top: 24rpx; right: 24rpx;
  background: #2D5A43; color: #fff; font-size: 24rpx;
  padding: 8rpx 20rpx; border-radius: 24rpx;
}
.content { margin-top: -40rpx; position: relative; z-index: 1; }
.top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.flower { font-size: 44rpx; font-weight: 700; }
.season { font-size: 24rpx; color: #e88d67; background: #fef3ee; padding: 6rpx 16rpx; border-radius: 8rpx; }
.place { font-size: 32rpx; font-weight: 600; display: block; }
.city { font-size: 26rpx; color: #999; display: block; margin: 8rpx 0 24rpx; }
.quote { padding: 28rpx; font-size: 28rpx; color: #2D5A43; line-height: 1.6; margin-bottom: 24rpx; }
.info-row {
  display: flex; justify-content: space-between; padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0; font-size: 28rpx;
}
.info-label { color: #999; }
.info-val { color: #2D3A3A; font-weight: 500; }
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #eee;
}
.btn-map {
  flex: 1; text-align: center; padding: 24rpx 0;
  border: 2rpx solid #2D5A43; color: #2D5A43;
  border-radius: 48rpx; font-size: 28rpx; font-weight: 600;
}
.btn-book {
  flex: 1; text-align: center; padding: 24rpx 0;
  background: #2D5A43; color: #fff;
  border-radius: 48rpx; font-size: 28rpx; font-weight: 600;
}
