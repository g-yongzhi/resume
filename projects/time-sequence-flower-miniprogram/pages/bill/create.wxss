.section {
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.section-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}
.input-main {
  font-size: 32rpx;
  color: #2D3A3A;
  padding: 8rpx 0;
  font-weight: 500;
}
.placeholder {
  color: #ccc;
}
.hint {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 16rpx;
  display: block;
}

/* Date */
.date-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.date-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #2D3A3A;
  background: #f9f9f7;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  flex: 1;
}
.date-picker.empty {
  color: #ccc;
}
.date-sep {
  font-size: 24rpx;
  color: #bbb;
}

/* Members */
.member-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.member-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #f9f9f7;
  padding: 12rpx 20rpx 12rpx 12rpx;
  border-radius: 32rpx;
}
.chip-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chip-avatar text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}
.chip-name {
  font-size: 26rpx;
  color: #2D3A3A;
}
.chip-remove {
  font-size: 22rpx;
  color: #ccc;
  margin-left: 4rpx;
}
.add-member-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.input-member {
  flex: 1;
  font-size: 28rpx;
  color: #2D3A3A;
  background: #f9f9f7;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}
.btn-add-member {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #2D5A43;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* Bottom */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fcfcf9;
}
.btn-primary.disabled {
  opacity: 0.45;
  pointer-events: none;
}
