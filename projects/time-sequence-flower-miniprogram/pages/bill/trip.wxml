<view class="container" wx:if="{{trip}}">
  <!-- Header -->
  <view class="trip-header">
    <view class="trip-header-inner">
      <text class="trip-name font-serif">{{trip.name}}</text>
      <view class="trip-meta-row">
        <text class="trip-dest" wx:if="{{trip.destination}}">{{trip.destination}}</text>
        <text class="trip-date" wx:if="{{trip.startDate}}">{{trip.startDate}} {{trip.endDate ? ' → ' + trip.endDate : ''}}</text>
      </view>
    </view>
  </view>

  <!-- Stats -->
  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-num">¥{{totalExpense}}</text>
      <text class="stat-label">总消费</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">¥{{perPerson}}</text>
      <text class="stat-label">人均</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{expenseCount}}</text>
      <text class="stat-label">笔</text>
    </view>
  </view>

  <!-- 消费列表 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title font-serif">消费记录</text>
      <text class="section-count">共 {{expenseCount}} 笔</text>
    </view>

    <block wx:if="{{expenses.length > 0}}">
      <view class="date-group" wx:for="{{groupedExpenses}}" wx:key="date">
        <view class="date-header">
          <text class="date-label">{{item.date}}  总 ¥{{item.dayTotal}}</text>
        </view>
        <view class="card expense-card" wx:for="{{item.items}}" wx:key="id" wx:for-item="exp" wx:for-index="ei"
          data-id="{{exp.id}}"
          bindtap="onExpenseTap"
          bindlongpress="onExpenseLongPress"
        >
          <view class="exp-icon" style="background: {{exp.category === 'food' ? '#fff3e0' : exp.category === 'transport' ? '#e3f2fd' : exp.category === 'hotel' ? '#e8f5e9' : exp.category === 'tickets' ? '#fce4ec' : '#f3e5f5'}};">
            <ui-icon name="{{exp.category === 'food' ? 'utensils' : exp.category === 'transport' ? 'compass' : exp.category === 'hotel' ? 'hotel' : exp.category === 'tickets' ? 'ticket' : 'sparkles'}}" size="28" />
          </view>
          <view class="exp-info">
            <text class="exp-desc">{{exp.desc || (exp.category === 'food' ? '餐饮' : exp.category === 'transport' ? '交通' : exp.category === 'hotel' ? '住宿' : exp.category === 'tickets' ? '门票' : '其他')}}</text>
            <text class="exp-payer">{{exp.paidByName}} 支付</text>
          </view>
          <text class="exp-amount">-¥{{exp.amount}}</text>
        </view>
      </view>
    </block>

    <view class="empty-mini" wx:else>
      <text class="empty-text">还没有消费记录</text>
    </view>

    <view class="add-expense-btn" bindtap="onAddExpense">
      <ui-icon name="plus" size="28" style="color: #2D5A43;" />
      <text>添加消费记录</text>
    </view>
  </view>

  <!-- 同行人 -->
  <view class="section">
    <view class="section-line-row">
      <text class="section-title font-serif">同行成员</text>
      <text class="section-count">（{{members.length}}人）</text>
    </view>
    <view class="card member-card">
      <scroll-view scroll-x class="member-scroll">
        <view class="member-chip" wx:for="{{members}}" wx:key="id">
          <view class="m-avatar" style="background: {{item.color}};">
            <text>{{item.name[0]}}</text>
          </view>
          <text class="m-name">{{item.name}}</text>
        </view>
      </scroll-view>
      <view class="member-actions">
        <view class="btn-text" bindtap="onManageMembers">管理成员</view>
      </view>
    </view>
  </view>

  <!-- 账单结算 -->
  <view class="section" wx:if="{{debts.length > 0}}">
    <view class="section-head">
      <text class="section-title font-serif">账单结算</text>
    </view>
    <view class="card">
      <!-- 余额一览 -->
      <view class="balance-list">
        <view class="balance-item" wx:for="{{members}}" wx:key="id" wx:for-item="m">
          <view class="b-avatar" style="background: {{m.color}};">
            <text>{{m.name[0]}}</text>
          </view>
          <text class="b-name">{{m.name}}</text>
          <text class="b-net {{balances[m.id].net > 0 ? 'positive' : balances[m.id].net < 0 ? 'negative' : 'zero'}}">
            {{balances[m.id].net > 0 ? '应收 ¥' + balances[m.id].net : balances[m.id].net < 0 ? '应付 ¥' + (-balances[m.id].net) : '已平账'}}
          </text>
        </view>
      </view>

      <!-- 债务关系 -->
      <view class="debt-list" wx:if="{{debts.length > 0}}">
        <view class="debt-divider"></view>
        <text class="debt-title">应付关系</text>
        <view class="debt-item" wx:for="{{debts}}" wx:key="index">
          <view class="debt-flow">
            <text class="debt-from">{{item.fromMember.name}}</text>
            <ui-icon name="chevron-right" size="24" style="color: #ccc;" />
            <text class="debt-to">{{item.toMember.name}}</text>
          </view>
          <view class="debt-right">
            <text class="debt-amount">¥{{item.amount}}</text>
            <view
              class="btn-settle"
              data-from="{{item.fromMember.id}}"
              data-to="{{item.toMember.id}}"
              data-amount="{{item.amount}}"
              bindtap="onSettleDebt"
            >结清</view>
          </view>
        </view>
      </view>

      <!-- 已结算记录 -->
      <block wx:if="{{settlements.length > 0}}">
        <view class="debt-divider"></view>
        <text class="debt-title settled-title">已结清</text>
        <view class="settled-item" wx:for="{{settlements}}" wx:key="id">
          <ui-icon name="check-circle" size="28" style="color: #2D5A43;" />
          <text class="settled-text">{{item.fromName}} → {{item.toName}} ¥{{item.amount}}</text>
          <text class="settled-date">{{item.date}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-actions">
    <view class="btn-outline" bindtap="onMoreActions">更多操作</view>
  </view>

  <!-- FAB -->
  <view class="fab" bindtap="onAddExpense">
    <ui-icon name="plus" size="48" style="color: #fff;" />
  </view>
</view>

<!-- 成员管理弹窗 -->
<view class="modal-mask" wx:if="{{showMemberModal}}" bindtap="closeMemberModal"></view>
<view class="modal-sheet" wx:if="{{showMemberModal}}">
  <view class="modal-head">
    <text class="modal-title">管理成员</text>
    <text class="modal-close" bindtap="closeMemberModal">完成</text>
  </view>
  <!-- 现有成员 -->
  <view class="modal-member-list">
    <view class="modal-member" wx:for="{{members}}" wx:key="id">
      <view class="mm-avatar" style="background: {{item.color}};">
        <text>{{item.name[0]}}</text>
      </view>
      <text class="mm-name">{{item.name}}</text>
      <text class="mm-remove" data-id="{{item.id}}" bindtap="removeMemberConfirm">移除</text>
    </view>
  </view>
  <!-- 添加新成员 -->
  <view class="modal-add-row">
    <input
      class="modal-input"
      placeholder="输入新成员姓名"
      placeholder-class="placeholder"
      value="{{newMemberName}}"
      bindinput="onNewMemberInput"
      maxlength="8"
    />
    <view class="btn-add" bindtap="addMember">添加</view>
  </view>
</view>

<!-- 结算确认弹窗 -->
<view class="modal-mask" wx:if="{{showSettleModal}}" bindtap="closeSettleModal"></view>
<view class="modal-confirm" wx:if="{{showSettleModal}}">
  <text class="mc-title">确认结清</text>
  <text class="mc-desc">{{settleTarget.fromName}} 向 {{settleTarget.toName}} 支付 ¥{{settleTarget.amount}} 已完成？</text>
  <view class="mc-btns">
    <view class="mc-btn cancel" bindtap="closeSettleModal">取消</view>
    <view class="mc-btn confirm" bindtap="confirmSettle">确认结清</view>
  </view>
</view>
