.section {
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.section-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 18rpx;
  display: block;
}
.section-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}
.select-all {
  font-size: 24rpx;
  color: #2D5A43;
}

/* Category */
.cat-row {
  display: flex;
  gap: 16rpx;
}
.cat-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #eef5f0;
  flex: 1;
  text-align: center;
}
.cat-chip text {
  font-size: 22rpx;
  color: #2D5A43;
}
.cat-chip.active {
  background: #2D5A43;
}
.cat-chip.active text {
  color: #fff;
}

/* Amount */
.amount-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 8rpx;
}
.amount-sign {
  font-size: 48rpx;
  font-weight: 700;
  color: #2D5A43;
  margin-right: 8rpx;
  font-family: var(--font-serif, 'Noto Serif SC', serif);
}
.amount-input {
  font-size: 56rpx;
  font-weight: 700;
  color: #2D3A3A;
  font-family: var(--font-serif, 'Noto Serif SC', serif);
  width: 300rpx;
  text-align: center;
}
.amount-placeholder {
  color: #ddd;
}

/* Date picker */
.picker-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  color: #2D3A3A;
  background: #f9f9f7;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}

/* Desc */
.desc-input {
  font-size: 28rpx;
  color: #2D3A3A;
  background: #f9f9f7;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}
.placeholder {
  color: #ccc;
}

/* Payer */
.payer-scroll {
  width: 100%;
  white-space: nowrap;
}
.payer-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  vertical-align: top;
}
.payer-chip.selected {
  border-color: #2D5A43;
  background: #eef5f0;
}
.payer-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.payer-avatar text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}
.payer-name {
  font-size: 22rpx;
  color: #2D3A3A;
  margin-top: 8rpx;
}

/* Split */
.split-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f9f9f7;
}
.split-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.split-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.split-avatar text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}
.split-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #2D3A3A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.split-share {
  font-size: 28rpx;
  font-weight: 600;
  color: #e88d67;
}
.hint {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 16rpx;
  display: block;
  text-align: center;
}

/* Extend page padding for fixed bottom bar */
.container.page-pad {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* Bottom */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fcfcf9;
}
.btn-primary.disabled {
  opacity: 0.45;
  pointer-events: none;
}
.btn-delete {
  text-align: center;
  color: #e57373;
  font-size: 26rpx;
  padding: 24rpx 0 8rpx;
}
