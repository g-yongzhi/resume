<view class="container page-pad">
  <!-- 分类选择 -->
  <view class="section card">
    <text class="section-label">分类</text>
    <view class="cat-row">
      <view
        class="cat-chip {{category === item.key ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onCategoryTap"
      >
        <ui-icon name="{{item.icon}}" size="28" style="color: {{category === item.key ? '#fff' : '#2D5A43'}};" />
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 金额 -->
  <view class="section card">
    <text class="section-label">金额</text>
    <view class="amount-row">
      <text class="amount-sign">¥</text>
      <input
        class="amount-input"
        type="number"
        placeholder="0"
        placeholder-class="amount-placeholder"
        value="{{amount}}"
        bindinput="onAmountInput"
        focus="{{!isEdit}}"
        maxlength="8"
      />
    </view>
  </view>

  <!-- 日期 -->
  <view class="section card">
    <text class="section-label">日期</text>
    <picker mode="date" value="{{date}}" bindchange="onDateChange">
      <view class="picker-row">
        <ui-icon name="calendar" size="32" style="color: #999;" />
        <text>{{date || '选择日期'}}</text>
      </view>
    </picker>
  </view>

  <!-- 描述 -->
  <view class="section card">
    <text class="section-label">描述（选填）</text>
    <input
      class="desc-input"
      placeholder="消费说明"
      placeholder-class="placeholder"
      value="{{desc}}"
      bindinput="onDescInput"
      maxlength="20"
    />
  </view>

  <!-- 付款人 -->
  <view class="section card">
    <text class="section-label">付款人</text>
    <scroll-view scroll-x class="payer-scroll">
      <view
        class="payer-chip {{paidBy === item.id ? 'selected' : ''}}"
        wx:for="{{members}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onPayerTap"
      >
        <view class="payer-avatar" style="background: {{item.color}};">
          <text>{{item.name[0]}}</text>
        </view>
        <text class="payer-name">{{item.name}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 分摊成员 -->
  <view class="section card">
    <view class="section-row">
      <text class="section-label">分摊成员</text>
      <text class="select-all" bindtap="onSelectAll">全选</text>
    </view>
    <view class="split-list">
      <view
        class="split-item"
        wx:for="{{members}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSplitToggle"
      >
        <view class="split-check" style="{{item.checked ? 'border-color: #2D5A43;' : ''}}">
          <text wx:if="{{item.checked}}" style="font-size: 28rpx; color: #2D3A3A; font-weight: 700;">✓</text>
        </view>
        <view class="split-avatar" style="background: {{item.color}};">
          <text>{{item.name[0]}}</text>
        </view>
        <text class="split-name">{{item.name}}</text>
        <text class="split-share" wx:if="{{splitPreview[item.id]}}">¥{{splitPreview[item.id]}}</text>
      </view>
    </view>
    <text class="hint">均分金额，¥{{amount || '0'}} ÷ {{splitMembers.length}}人</text>
  </view>

  <!-- 保存 -->
  <view class="bottom-bar">
    <view class="btn-primary {{canSave ? '' : 'disabled'}}" bindtap="onSave">
      {{isEdit ? '保存修改' : '记录消费'}}
    </view>
    <view class="btn-delete" wx:if="{{isEdit}}" bindtap="onDelete">删除此消费</view>
  </view>
</view>
