<view class="container">
  <!-- Header -->
  <view class="header">
    <image class="header-bg" src="{{billTop}}" mode="aspectFill" />
    <view class="header-mask"></view>
    <view class="header-content">
      <text class="header-kicker">花期旅行</text>
      <text class="header-title font-serif">AA记账</text>
      <text class="header-sub">旅途花销，公平分摊</text>
      <view class="total-box" wx:if="{{hasTrips}}">
        <text class="total-label">全部行程累计</text>
        <text class="total-amount">¥{{totalAmount}}</text>
      </view>
    </view>
  </view>

  <!-- Body -->
  <view class="body page-pad">
    <!-- 行程列表 -->
    <block wx:if="{{hasTrips}}">
      <view class="list-head">
        <text class="list-title font-serif">我的行程</text>
        <text class="list-count">共 {{totalTrips}} 次</text>
      </view>

      <view
        class="trip-card card"
        wx:for="{{trips}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-item="{{item}}"
        bindtap="onTripTap"
        bindlongpress="onTripLongPress"
      >
        <view class="trip-row">
          <view class="trip-info">
            <text class="trip-name font-serif">{{item.name}}</text>
            <view class="trip-meta">
              <text class="trip-dest" wx:if="{{item.destination}}">{{item.destination}}</text>
              <text class="trip-date" wx:if="{{item.startDate}}">{{item.startDate}}{{item.endDate ? ' - ' + item.endDate : ''}}</text>
            </view>
            <view class="trip-tags">
              <view class="tag tag-member">
                <ui-icon name="user" size="22" />
                <text>{{item.members.length}}人</text>
              </view>
              <view class="tag tag-status {{item.isFullySettled ? 'settled' : 'active'}}">
                {{item.isFullySettled ? '已结清' : '进行中'}}
              </view>
            </view>
          </view>
          <view class="trip-amount">
            <text class="amount-num">¥{{item.totalExpense}}</text>
            <text class="amount-label">{{item.expenseCount}}笔</text>
          </view>
          <ui-icon name="chevron-right" size="32" class="trip-arrow" />
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <ui-icon name="sparkles" size="80" />
      <text class="empty-title">还没有旅行记录</text>
      <text class="empty-sub">记录您的第一笔花期旅行吧</text>
      <view class="btn-primary empty-btn" bindtap="onCreateTap">创建行程</view>
    </view>
  </view>

  <!-- FAB -->
  <view class="fab" wx:if="{{hasTrips}}" bindtap="onCreateTap">
    <ui-icon name="plus" size="48" style="color: #fff;" />
  </view>
</view>
