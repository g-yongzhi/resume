/* Header */
.trip-header {
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #2D5A43 0%, #3a7d5a 100%);
}
.trip-header-inner {
  color: #fff;
}
.trip-name {
  font-size: 40rpx;
  font-weight: 700;
}
.trip-meta-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}
.trip-dest {
  font-size: 24rpx;
  opacity: 0.85;
}
.trip-date {
  font-size: 24rpx;
  opacity: 0.7;
}
.trip-total {
  margin-top: 20rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #e88d67;
}

/* Stats */
.stats-row {
  display: flex;
  margin: -24rpx 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  position: relative;
  z-index: 2;
}
.stat-item {
  flex: 1;
  text-align: center;
  position: relative;
}
.stat-item + .stat-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  bottom: 20%;
  width: 1rpx;
  background: #f0f0f0;
}
.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2D5A43;
  font-family: var(--font-serif, 'Noto Serif SC', serif);
}
.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

/* Section */
.section {
  padding: 0 24rpx 24rpx;
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3A3A;
}
.section-count {
  font-size: 24rpx;
  color: #bbb;
}
.section-line-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

/* Expense */
.date-group {
  margin-bottom: 20rpx;
}
.date-header {
  padding: 8rpx 8rpx 12rpx;
}
.date-label {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}
.expense-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 12rpx;
}
.exp-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.exp-info {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}
.exp-desc {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #2D3A3A;
}
.exp-payer {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
  display: block;
}
.exp-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: #e88d67;
  flex-shrink: 0;
}
.empty-mini {
  padding: 60rpx 0;
  text-align: center;
}
.empty-text {
  font-size: 26rpx;
  color: #ccc;
}
.add-expense-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  border: 2rpx dashed #2D5A43;
  color: #2D5A43;
  border-radius: 20rpx;
  font-size: 26rpx;
}

/* Members */
.member-card {
  padding: 24rpx;
}
.member-scroll {
  width: 100%;
  white-space: nowrap;
}
.member-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 28rpx;
  vertical-align: top;
}
.m-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.m-avatar text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}
.m-name {
  font-size: 22rpx;
  color: #2D3A3A;
  margin-top: 8rpx;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.member-actions {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}
.btn-text {
  text-align: center;
  font-size: 26rpx;
  color: #2D5A43;
}

/* Balance */
.balance-list {
  padding: 8rpx 0 16rpx;
}
.balance-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.b-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.b-avatar text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}
.b-name {
  flex: 1;
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #2D3A3A;
}
.b-net {
  font-size: 26rpx;
  font-weight: 600;
}
.b-net.positive { color: #2D5A43; }
.b-net.negative { color: #e88d67; }
.b-net.zero { color: #999; font-weight: 400; }

/* Debts */
.debt-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 16rpx 0;
}
.debt-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  display: block;
}
.settled-title {
  color: #2D5A43;
}
.debt-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}
.debt-flow {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.debt-from, .debt-to {
  font-size: 26rpx;
  color: #2D3A3A;
}
.debt-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.debt-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #e88d67;
}
.btn-settle {
  font-size: 22rpx;
  color: #2D5A43;
  background: #eef5f0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* Settlements */
.settled-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 0;
}
.settled-text {
  flex: 1;
  font-size: 24rpx;
  color: #999;
}
.settled-date {
  font-size: 22rpx;
  color: #ccc;
}

/* Bottom */
.bottom-actions {
  padding: 20rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
}
.btn-outline {
  text-align: center;
  padding: 22rpx 0;
  border: 2rpx solid #2D5A43;
  color: #2D5A43;
  border-radius: 48rpx;
  font-size: 28rpx;
}

/* FAB */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #2D5A43;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(45, 90, 67, 0.35);
  z-index: 100;
}

/* Modal */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 500;
}
.modal-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 501;
  max-height: 70vh;
  overflow-y: auto;
}
.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3A3A;
}
.modal-close {
  font-size: 28rpx;
  color: #2D5A43;
}
.modal-member {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.mm-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mm-avatar text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}
.mm-name {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #2D3A3A;
}
.mm-remove {
  font-size: 24rpx;
  color: #e57373;
}
.modal-add-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}
.modal-input {
  flex: 1;
  font-size: 28rpx;
  background: #f9f9f7;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
}
.btn-add {
  font-size: 26rpx;
  color: #fff;
  background: #2D5A43;
  padding: 18rpx 32rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

/* Confirm modal */
.modal-confirm {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  z-index: 501;
  width: 520rpx;
  text-align: center;
}
.mc-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3A3A;
  display: block;
}
.mc-desc {
  font-size: 26rpx;
  color: #777;
  margin-top: 16rpx;
  display: block;
}
.mc-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.mc-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 48rpx;
  font-size: 28rpx;
  text-align: center;
}
.mc-btn.cancel {
  background: #f5f5f5;
  color: #999;
}
.mc-btn.confirm {
  background: #2D5A43;
  color: #fff;
}
