.detail-page { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.cover { width: 100%; height: 440rpx; }
.content { margin-top: -48rpx; position: relative; z-index: 1; }
.type-tabs { white-space: nowrap; margin-bottom: 24rpx; }
.type-tab {
  display: inline-block; padding: 10rpx 24rpx; margin-right: 12rpx;
  font-size: 24rpx; color: #666; background: #fff; border-radius: 24rpx;
  border: 1rpx solid #eee; text-transform: capitalize;
}
.type-tab.active { background: #2D5A43; color: #fff; border-color: #2D5A43; }
.head-row { display: flex; justify-content: space-between; align-items: center; }
.title { font-size: 48rpx; font-weight: 700; }
.status { font-size: 22rpx; color: #2D5A43; background: #eef5f0; padding: 6rpx 16rpx; border-radius: 20rpx; }
.city { font-size: 26rpx; color: #e88d67; display: block; margin: 12rpx 0; }
.desc { font-size: 28rpx; color: #555; line-height: 1.6; display: block; margin-bottom: 24rpx; }
.section { padding: 24rpx; margin-bottom: 20rpx; }
.section-label { font-size: 28rpx; font-weight: 600; display: block; margin-bottom: 16rpx; }
.spots { display: flex; flex-direction: column; gap: 10rpx; }
.spot { font-size: 26rpx; color: #555; }
.tips { padding: 24rpx; background: #fef9f6; border-color: rgba(232,141,103,0.2); }
.tips-label { font-size: 26rpx; color: #e88d67; font-weight: 600; display: block; margin-bottom: 10rpx; }
.tips-text { font-size: 26rpx; color: #666; line-height: 1.5; }
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #eee;
}
.btn-book {
  background: #2D5A43; color: #fff; text-align: center;
  font-size: 30rpx; font-weight: 600; padding: 28rpx 0; border-radius: 48rpx;
}
