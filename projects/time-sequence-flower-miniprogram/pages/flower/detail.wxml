<view class="container detail-page" wx:if="{{flower}}">
  <image class="cover" src="{{flower.image}}" mode="aspectFill" />
  <view class="content page-pad">
    <scroll-view scroll-x class="type-tabs" enhanced show-scrollbar="{{false}}">
      <text
        wx:for="{{types}}"
        wx:key="*this"
        class="type-tab {{activeType === item ? 'active' : ''}}"
        data-type="{{item}}"
        bindtap="onTypeTap"
      >{{item}}</text>
    </scroll-view>

    <view class="head-row">
      <text class="title font-serif">{{flower.name}}</text>
      <text class="status">{{flower.status}}</text>
    </view>
    <text class="city">{{flower.city}} · {{flower.season}}</text>
    <text class="desc">{{flower.desc}}</text>

    <view class="section card">
      <text class="section-label">推荐赏花期</text>
      <view class="spots">
        <text class="spot" wx:for="{{flower.spots}}" wx:key="*this">· {{item}}</text>
      </view>
    </view>

    <view class="tips card">
      <text class="tips-label">赏花贴士</text>
      <text class="tips-text">{{flower.tips}}</text>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="btn-book" bindtap="onPlan">制定花期行程</view>
  </view>
</view>
