<view class="container detail-page" wx:if="{{feed}}">
  <image class="cover" src="{{feed.image}}" mode="aspectFill" />
  <view class="content page-pad">
    <text class="tag">{{feed.tag}}</text>
    <text class="title font-serif">{{feed.title}}</text>
    <view class="author-row">
      <text class="author">{{feed.author}}</text>
      <view class="likes">
        <ui-icon name="heart" size="28" />
        <text>{{feed.likes}}</text>
      </view>
    </view>
    <view class="article card">
      <text class="article-text">{{feed.content}}</text>
    </view>
  </view>
  <view class="bottom-bar">
    <view class="btn-outline" bindtap="onCollect">收藏</view>
    <view class="btn-book" bindtap="onLike">点赞</view>
  </view>
</view>
