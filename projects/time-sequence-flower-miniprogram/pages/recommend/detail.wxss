.detail-page { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.cover { width: 100%; height: 400rpx; }
.content { margin-top: -24rpx; }
.tag {
  display: inline-block; font-size: 22rpx; color: #2D5A43;
  background: #eef5f0; padding: 6rpx 16rpx; border-radius: 8rpx;
}
.title { font-size: 36rpx; font-weight: 700; display: block; margin: 16rpx 0; line-height: 1.45; }
.author-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.author { font-size: 26rpx; color: #999; }
.likes { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; color: #e88d67; }
.article { padding: 28rpx; }
.article-text { font-size: 28rpx; color: #555; line-height: 1.8; }
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #eee;
}
.btn-outline {
  flex: 1; text-align: center; padding: 24rpx 0;
  border: 2rpx solid #2D5A43; color: #2D5A43;
  border-radius: 48rpx; font-size: 28rpx; font-weight: 600;
}
.btn-book {
  flex: 1; text-align: center; padding: 24rpx 0;
  background: #2D5A43; color: #fff;
  border-radius: 48rpx; font-size: 28rpx; font-weight: 600;
}
