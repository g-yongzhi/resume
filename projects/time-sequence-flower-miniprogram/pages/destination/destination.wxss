.page-head {
  padding: 32rpx 28rpx 40rpx;
  background: linear-gradient(180deg, #eef5f0 0%, #fcfcf9 100%);
}

.head-kicker {
  display: block;
  font-size: 22rpx;
  color: #e88d67;
  letter-spacing: 0.15em;
}

.head-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #2D3A3A;
  margin: 8rpx 0;
}

.head-sub {
  font-size: 24rpx;
  color: #999;
}

.city-list {
  padding: 0 24rpx;
}

.city-card {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  overflow: hidden;
  padding-right: 20rpx;
}

.city-img {
  width: 180rpx;
  height: 140rpx;
  flex-shrink: 0;
}

.city-info {
  padding: 20rpx;
  flex: 1;
}

.city-name {
  font-size: 32rpx;
  font-weight: 700;
}

.city-flower {
  display: block;
  font-size: 22rpx;
  color: #2D5A43;
  margin: 6rpx 0;
}

.city-desc {
  font-size: 24rpx;
  color: #999;
}

.spot-list {
  padding: 0 24rpx 24rpx;
}

.spot-item {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.spot-img {
  width: 100%;
  height: 280rpx;
}

.spot-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: rgba(45, 90, 67, 0.85);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.spot-info {
  padding: 20rpx 24rpx 24rpx;
}

.spot-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.spot-name {
  font-size: 34rpx;
  font-weight: 700;
}

.spot-season {
  font-size: 22rpx;
  color: #e88d67;
}

.spot-place {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin: 10rpx 0;
}

.spot-desc {
  font-size: 26rpx;
  color: #2D3A3A;
  line-height: 1.5;
}

.spot-views {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}
