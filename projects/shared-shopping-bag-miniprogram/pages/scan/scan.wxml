<view class="page">
  <view class="mode-switch">
    <view class="mode-item {{mode === 'borrow' ? 'active' : ''}}" data-mode="borrow" bindtap="onSwitchMode">Borrow</view>
    <view class="mode-item {{mode === 'return' ? 'active' : ''}}" data-mode="return" bindtap="onSwitchMode">Return</view>
  </view>
  <view class="scan-frame">
    <view class="scan-corner tl" /><view class="scan-corner tr" />
    <view class="scan-corner bl" /><view class="scan-corner br" />
    <view class="scan-line" />
    <text class="scan-tip">Align QR code within the frame</text>
  </view>
  <view class="station-tag card" bindtap="onChangeStation">
    <text class="station-tag__label">Current Station · Tap to change</text>
    <text class="station-tag__name">{{stationName}}</text>
    <text class="station-tag__arrow">›</text>
  </view>
  <button class="scan-btn" bindtap="onSimulateScan">Tap to Scan</button>
  <text class="hint" wx:if="{{mode === 'borrow'}}">Tap to scan the station QR code and borrow a bag.</text>
  <text class="hint" wx:else>Active rentals: {{activeCount}}. Scan any station to return your bag.</text>
</view>