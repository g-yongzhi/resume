.mode-switch {
  margin-bottom: 32rpx;
}

.scan-frame {
  position: relative;
  height: 480rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1a2e24;
  border-radius: var(--radius-card);
  border: 1rpx solid var(--color-border);
  overflow: hidden;
  box-shadow: var(--shadow-card-lg);
}

.scan-corner {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid var(--color-primary-light);
}

.scan-corner.tl { top: 40rpx; left: 40rpx; border-right: none; border-bottom: none; }
.scan-corner.tr { top: 40rpx; right: 40rpx; border-left: none; border-bottom: none; }
.scan-corner.bl { bottom: 40rpx; left: 40rpx; border-right: none; border-top: none; }
.scan-corner.br { bottom: 40rpx; right: 40rpx; border-left: none; border-top: none; }

.scan-line {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, var(--color-primary-light), transparent);
  animation: scanMove 2s linear infinite;
}

@keyframes scanMove {
  0% { top: 80rpx; opacity: 0.3; }
  50% { opacity: 1; }
  100% { top: 400rpx; opacity: 0.3; }
}

.scan-tip {
  color: rgba(255, 255, 255, 0.75);
  font-size: 26rpx;
  z-index: 1;
}

.station-tag {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
  position: relative;
}

.station-tag__arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #aaa;
}

.station-tag__label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.station-tag__name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}

.scan-btn {
  margin-bottom: 24rpx;
}

.hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}
