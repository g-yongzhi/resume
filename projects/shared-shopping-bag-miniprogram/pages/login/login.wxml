<view class="page">
  <view class="brand">
    <image class="brand-icon" src="/assets/images/logo-icon.png" mode="aspectFit" />
    <text class="brand-name">EcoBag</text>
    <text class="brand-tagline">Share. Reuse. Green.</text>
  </view>
  <view class="action">
    <button class="btn" bindtap="onLogin" loading="{{logging}}" disabled="{{logging}}">Sign in with WeChat</button>
    <text class="note">Your information is only used for identity verification.</text>
  </view>
</view>