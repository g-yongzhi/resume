.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0;
  padding-bottom: 0;
}

.map-wrap {
  position: relative;
  width: 100%;
  height: 48vh;
  min-height: 360rpx;
  flex-shrink: 0;
}

.map {
  width: 100%;
  height: 100%;
}

.map-action {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 999rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border);
}

.map-action__icon {
  font-size: 28rpx;
  color: var(--color-primary);
}

.map-action__text {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  padding: 24rpx 28rpx 0;
  border-radius: 24rpx 24rpx 0 0;
  margin-top: -20rpx;
  background: var(--color-bg);
  position: relative;
  z-index: 1;
}

.header {
  padding: 0 8rpx 16rpx;
}

.station-list {
  flex: 1;
  min-height: 0;
}

.station-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.station-item.active {
  border: 2rpx solid var(--color-primary);
  background: rgba(27, 94, 60, 0.05);
}

.station-item__name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.station-item__address {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.station-item__meta {
  text-align: right;
  margin-left: 24rpx;
}

.status {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-bottom: 8rpx;
}

.status.online {
  color: var(--color-success);
  background: rgba(7, 193, 96, 0.12);
}

.status.offline {
  color: #999;
  background: #f0f0f0;
}

.bags {
  display: block;
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.footer {
  padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: var(--color-bg);
}

.footer-info {
  margin-bottom: 16rpx;
}

.footer-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.footer-meta {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.footer-address {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.footer-actions {
  display: flex;
  gap: 16rpx;
}

.navigate-btn,
.use-btn {
  flex: 1;
  width: auto;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
}
