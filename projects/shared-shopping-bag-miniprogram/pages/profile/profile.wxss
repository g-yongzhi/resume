page {
  height: 100%;
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.page-top {
  flex-shrink: 0;
}

.page-bottom {
  flex-shrink: 0;
  margin-top: auto;
  padding-top: 20rpx;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card-lg);
}

.user-card.guest {
  position: relative;
}

.user-card__arrow {
  font-size: 36rpx;
  color: #aaa;
  margin-left: 12rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: var(--color-bg);
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.nickname {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.meta {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 12rpx;
  min-height: 120rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 8rpx;
  line-height: 1.2;
  text-align: center;
}

.stat-value.paid {
  color: var(--color-success);
}

.stat-value.unpaid {
  color: #e6a23c;
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.menu {
  flex-shrink: 0;
}

.menu-item {
  padding: 26rpx 28rpx;
}

.menu-item__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.menu-item__text {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text);
}

.menu-item__extra {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-right: 12rpx;
}

.quick-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.quick-card {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 96rpx;
  padding: 0 20rpx;
}

.quick-card__icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.quick-card__text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text);
}

.quick-card__arrow {
  font-size: 32rpx;
  color: #aaa;
}

.footer-tip {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx 28rpx;
}

.footer-tip__icon {
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.footer-tip__text {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.55;
}
