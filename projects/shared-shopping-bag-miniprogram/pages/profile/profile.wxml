<view class="page">
  <view class="page-top">
    <view class="user-card card" wx:if="{{user}}">
      <image class="avatar" src="{{user.avatar}}" mode="aspectFill" />
      <view class="user-info">
        <text class="nickname">{{user.nickname}}</text>
        <text class="meta">Deposit: {{user.depositText}} · {{user.depositAmountText}}</text>
        <text class="meta">{{membershipText}}</text>
      </view>
    </view>

    <view class="user-card card guest" wx:else bindtap="onSignIn">
      <image class="avatar" src="/assets/images/logo-icon.png" mode="aspectFill" />
      <view class="user-info">
        <text class="nickname">Guest</text>
        <text class="meta">Tap to sign in</text>
      </view>
      <text class="user-card__arrow">›</text>
    </view>

    <view class="stats-row">
      <view class="stat-card card" bindtap="onOrders">
        <text class="stat-value">{{orderCount}}</text>
        <text class="stat-label">Orders</text>
      </view>
      <view class="stat-card card" bindtap="onDeposit">
        <text class="stat-value {{depositPaid ? 'paid' : 'unpaid'}}">{{depositStatusShort}}</text>
        <text class="stat-label">Deposit</text>
      </view>
      <view class="stat-card card" bindtap="onDeposit">
        <text class="stat-value {{hasMembership ? 'paid' : ''}}">{{membershipShort}}</text>
        <text class="stat-label">Member</text>
      </view>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="onOrders">
      <image class="menu-item__icon" src="/assets/images/icon-history.png" mode="aspectFit" />
      <text class="menu-item__text">My Orders</text>
      <text class="menu-item__extra">{{orderCount}}</text>
      <text class="menu-item__arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onDeposit">
      <image class="menu-item__icon" src="/assets/images/icon-check.png" mode="aspectFit" />
      <text class="menu-item__text">Deposit Management</text>
      <text class="menu-item__arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onHelp">
      <image class="menu-item__icon" src="/assets/images/icon-clock.png" mode="aspectFit" />
      <text class="menu-item__text">Help & Support</text>
      <text class="menu-item__arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onSettings">
      <image class="menu-item__icon" src="/assets/icons/profile.png" mode="aspectFit" />
      <text class="menu-item__text">Settings</text>
      <text class="menu-item__arrow">›</text>
    </view>
  </view>

  <view class="page-bottom">
    <view class="quick-actions">
      <view class="quick-card card" bindtap="onNearbyStations">
        <image class="quick-card__icon" src="/assets/images/icon-stations.png" mode="aspectFit" />
        <text class="quick-card__text">Nearby Stations</text>
        <text class="quick-card__arrow">›</text>
      </view>
      <view class="quick-card card" bindtap="onScan">
        <image class="quick-card__icon" src="/assets/images/icon-scan.png" mode="aspectFit" />
        <text class="quick-card__text">Scan to Rent</text>
        <text class="quick-card__arrow">›</text>
      </view>
    </view>

    <view class="footer-tip card">
      <image class="footer-tip__icon" src="/assets/images/icon-check.png" mode="aspectFit" />
      <text class="footer-tip__text">Every bag reused helps reduce plastic waste. Thank you for going green with EcoBag.</text>
    </view>
  </view>
</view>
