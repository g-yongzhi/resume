.status-banner {
  text-align: center;
  padding: 48rpx 32rpx;
  border-radius: var(--radius-card);
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-border);
}

.status-banner.ongoing {
  background: rgba(25, 137, 250, 0.1);
}

.status-banner.returned {
  background: rgba(7, 193, 96, 0.1);
}

.status-banner.overdue {
  background: rgba(238, 10, 36, 0.1);
}

.status-banner__text {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.status-banner.ongoing .status-banner__text { color: #1989fa; }
.status-banner.returned .status-banner__text { color: var(--color-success); }
.status-banner.overdue .status-banner__text { color: #ee0a24; }

.status-banner__no {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.usage-banner {
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--radius-card);
  border: 1rpx solid var(--color-border);
}

.usage-banner.free {
  background: rgba(7, 193, 96, 0.1);
}

.usage-banner.paid {
  background: rgba(230, 162, 60, 0.12);
}

.usage-banner.warning {
  background: rgba(230, 162, 60, 0.16);
}

.usage-banner.overdue {
  background: rgba(238, 10, 36, 0.1);
}

.usage-banner__elapsed {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.usage-banner__text {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.45;
}

.usage-banner.free .usage-banner__text { color: var(--color-success); }
.usage-banner.warning .usage-banner__text,
.usage-banner.paid .usage-banner__text { color: #b88230; }
.usage-banner.overdue .usage-banner__text { color: #ee0a24; }

.card {
  padding: 8rpx 32rpx;
  margin-bottom: 20rpx;
}

.primary-btn {
  margin-top: 16rpx;
}
