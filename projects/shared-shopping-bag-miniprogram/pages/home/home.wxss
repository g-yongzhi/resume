page {
  height: 100%;
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.page-top {
  flex-shrink: 0;
}

.page-bottom {
  flex-shrink: 0;
  margin-top: 20rpx;
}

.scan-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
}

.scan-card__scan {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.scan-card__text {
  flex: 1;
  min-width: 0;
}

.scan-card__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
  line-height: 1.45;
  margin-bottom: 8rpx;
}

.scan-card__desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.scan-card__qr {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  padding: 10rpx;
  background: #fff;
  border: 1rpx solid var(--color-border);
  border-radius: 10rpx;
  box-sizing: border-box;
}

.station-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
}

.station-card__info {
  flex: 1;
  min-width: 0;
}

.station-card__arrow {
  font-size: 32rpx;
  color: #aaa;
  flex-shrink: 0;
}

.station-card__icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.station-card__name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 10rpx;
}

.station-card__status {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.rental-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  padding: 36rpx 32rpx 32rpx;
  margin-top: 20rpx;
  box-shadow: var(--shadow-card-lg);
}

.rental-card__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.rental-card__content {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 0;
  margin-bottom: 32rpx;
}

.rental-card__bag-wrap {
  flex-shrink: 0;
  width: 46%;
  height: 100%;
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rental-card__bag {
  width: 100%;
  height: 100%;
  max-height: 420rpx;
}

.rental-card__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.available-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  margin-bottom: 28rpx;
}

.available-label {
  font-size: 28rpx;
  color: var(--color-text-muted);
  margin-right: 10rpx;
}

.available-num {
  font-size: 88rpx;
  font-weight: 800;
  color: var(--color-primary);
  line-height: 1;
}

.meta-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.meta-icon {
  width: 32rpx;
  height: 32rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.meta-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-muted);
  line-height: 1.55;
}

.billing-link {
  margin-top: 8rpx;
  margin-bottom: 12rpx;
}

.billing-link__text {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.membership-hint {
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(27, 94, 60, 0.06);
}

.membership-hint.active {
  background: rgba(7, 193, 96, 0.12);
}

.membership-hint text {
  font-size: 24rpx;
  color: var(--color-primary);
  line-height: 1.45;
}

.quick-actions {
  display: flex;
  gap: 20rpx;
}

.quick-card {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 108rpx;
  padding: 0 24rpx;
}

.quick-card__icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.quick-card__text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text);
}

.quick-card__arrow {
  font-size: 32rpx;
  color: #aaa;
}
