.card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 12rpx;
}

.card-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.status-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  margin-bottom: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.badge {
  text-align: center;
  padding: 20rpx;
  background: rgba(7, 193, 96, 0.12);
  color: var(--color-success);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.tips {
  padding: 8rpx 16rpx;
}

.tips-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.tips-item {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
}
