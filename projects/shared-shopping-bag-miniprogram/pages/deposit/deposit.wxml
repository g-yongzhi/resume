<view class="page">
  <view class="card">
    <text class="card-title">Deposit</text>
    <text class="card-desc">A deposit of {{depositText}} is required to borrow bags. It will be refunded after you return all bags.</text>

    <view class="status-row">
      <text class="label">Status</text>
      <text class="value {{depositPaid ? 'paid' : 'unpaid'}}">{{depositPaid ? 'Paid' : 'Not Paid'}}</text>
    </view>

    <button
      wx:if="{{!depositPaid}}"
      class="primary-btn"
      bindtap="onPayDeposit"
      loading="{{processing}}"
    >
      Pay Deposit
    </button>
    <button
      wx:else
      class="secondary-btn"
      bindtap="onRefundDeposit"
      loading="{{processing}}"
    >
      Request Refund
    </button>
  </view>

  <view class="card">
    <text class="card-title">Membership</text>
    <text class="card-desc">{{membershipPrice}}/month — unlimited borrows during the valid period. Usage fees are waived.</text>

    <view class="status-row" wx:if="{{hasMembership}}">
      <text class="label">Expires</text>
      <text class="value paid">{{membershipExpiresText}}</text>
    </view>

    <button
      wx:if="{{!hasMembership}}"
      class="primary-btn"
      bindtap="onBuyMembership"
      loading="{{processing}}"
    >
      Purchase Membership
    </button>
    <view wx:else class="badge">Active</view>
  </view>

  <view class="tips">
    <text class="tips-title">Notes</text>
    <text class="tips-item">• Deposit is refunded after all bags are returned</text>
    <text class="tips-item">• Overdue returns (3+ days) forfeit the full deposit</text>
    <text class="tips-item">• Membership does not replace the deposit requirement</text>
  </view>
</view>
