<view class="page">
  <view class="tabs">
    <view
      class="tab {{tab === 'active' ? 'active' : ''}}"
      data-tab="active"
      bindtap="onSwitchTab"
    >
      Ongoing ({{activeOrders.length}})
    </view>
    <view
      class="tab {{tab === 'history' ? 'active' : ''}}"
      data-tab="history"
      bindtap="onSwitchTab"
    >
      History ({{historyOrders.length}})
    </view>
  </view>

  <view wx:if="{{tab === 'active'}}">
    <view wx:if="{{activeOrders.length === 0}}" class="empty">
      <text class="empty__text">{{tab === 'active' ? (t_orders_empty_active || emptyText) : (t_orders_empty_history || emptyText)}}</text>
      <button class="empty__btn" bindtap="onBorrowTap">Borrow a Bag</button>
    </view>

    <view
      class="order-card card"
      wx:for="{{activeOrders}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOrderTap"
    >
      <view class="order-card__header">
        <text class="order-card__no">#{{item.orderNo}}</text>
        <text class="order-card__status {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="order-card__row">
        <text class="label">Station</text>
        <text class="value">{{item.stationName}}</text>
      </view>
      <view class="order-card__row">
        <text class="label">Borrowed</text>
        <text class="value">{{item.borrowTimeText}}</text>
      </view>
      <view class="order-card__row">
        <text class="label">Bags</text>
        <text class="value">{{item.bagCount}}</text>
      </view>
      <view class="usage-banner {{item.usageClass}}" wx:if="{{item.usageText}}">
        <text class="usage-banner__elapsed">Borrowed {{item.elapsedText}}</text>
        <text class="usage-banner__text">{{item.usageText}}</text>
      </view>
      <view class="order-card__footer">
        <button
          class="return-btn"
          catchtap="onReturnTap"
          data-id="{{item.id}}"
          data-station="{{item.stationId}}"
        >
          Return Now
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{tab === 'history'}}">
    <view wx:if="{{historyOrders.length === 0}}" class="empty">
      <text class="empty__text">{{tab === 'active' ? (t_orders_empty_active || emptyText) : (t_orders_empty_history || emptyText)}}</text>
    </view>

    <view
      class="order-card card"
      wx:for="{{historyOrders}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOrderTap"
    >
      <view class="order-card__header">
        <text class="order-card__no">#{{item.orderNo}}</text>
        <text class="order-card__status {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="order-card__row">
        <text class="label">Station</text>
        <text class="value">{{item.stationName}}</text>
      </view>
      <view class="order-card__row">
        <text class="label">Borrowed</text>
        <text class="value">{{item.borrowTimeText}}</text>
      </view>
      <view class="order-card__row">
        <text class="label">Returned</text>
        <text class="value">{{item.returnTimeText}}</text>
      </view>
      <view class="order-card__row">
        <text class="label">Total Charge</text>
        <text class="value highlight">{{item.totalText}}</text>
      </view>
    </view>
  </view>
</view>
