.card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 24rpx;
}

.counter {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 16rpx;
}

.counter-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-bg);
  color: var(--color-primary);
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  border: 1rpx solid var(--color-border);
}

.counter-value {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--color-primary);
  min-width: 60rpx;
  text-align: center;
}

.card-tip {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.primary-btn {
  margin-top: 24rpx;
}
