.card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 24rpx;
}

.order-item {
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--color-border);
  margin-bottom: 16rpx;
}

.order-item:last-child {
  margin-bottom: 0;
}

.order-item.active {
  border-color: var(--color-primary);
  background: rgba(27, 94, 60, 0.05);
}

.order-item__top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.order-item__id {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.order-item__count {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.order-item__time {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.primary-btn {
  margin-top: 24rpx;
}
